local r = game:GetService("RunService")
local w = game:GetService("Workspace")
local h = game:GetService("HttpService")

local m = {}
m.__index = m

local a = {}

local d = {
 layers = 4,
 bands = 14,
 wobble = 0.18,
 spread = 1.6,
 speed = 1.05,
 radius = 200,
 maxc = 180,
 refreq = 1.8,
 corner = 22,
 chroma = true,
 bandh = 0.055,
 usefolder = true,
 debug = false
}

local function q(u,v)
 local t = {}
 for i,o in pairs(u) do t[i] = o end
 if v then
  for i,o in pairs(v) do
   t[i] = o
  end
 end
 return t
end

local function k(p,o)
 for _,x in pairs(p:GetChildren()) do x:Destroy() end
 local g = w:FindFirstChild("GlassCloneTargets")
 if o.usefolder and g then
  for _,x in pairs(g:GetDescendants()) do
   if x:IsA("BasePart") or x:IsA("Model") then
    local ok,b = pcall(function() return x:Clone() end)
    if ok and b then
     for _,y in pairs(b:GetDescendants()) do
      if y:IsA("BasePart") then
       y.CanCollide = false
       y.Anchored = true
      elseif y:IsA("Humanoid") then
       y:Destroy()
      elseif y:IsA("Script") or y:IsA("LocalScript") or y:IsA("ModuleScript") then
       y:Destroy()
      end
     end
     b.Parent = p
    end
   end
  end
  return
 end
 local c = w.CurrentCamera
 local z = c and c.CFrame.Position or Vector3.new()
 local n = 0
 for _,x in pairs(w:GetDescendants()) do
  if n >= (o.maxc or d.maxc) then break end
  if x:IsA("BasePart") and x.Parent ~= p and not x:IsDescendantOf(p) then
   local ok,b = pcall(function() return x.Position end)
   if ok and b and (b - z).Magnitude <= (o.radius or d.radius) then
    local v = x:Clone()
    for _,y in pairs(v:GetDescendants()) do
     if y:IsA("BasePart") then
      y.CanCollide = false
      y.Anchored = true
     elseif y:IsA("Humanoid") then
      y:Destroy()
     elseif y:IsA("Script") or y:IsA("LocalScript") or y:IsA("ModuleScript") then
      y:Destroy()
     end
    end
    v.Parent = p
    n = n + 1
   end
  end
 end
end

local function b(t,o)
 local u = {}
 local c = math.clamp(o.bands or d.bands,0,64)
 local s = o.bandh or d.bandh
 if c <= 0 then return {holder=nil,bands=u} end
 local f = Instance.new("Frame")
 f.Name = "lg_bands"
 f.Size = UDim2.fromScale(1,1)
 f.BackgroundTransparency = 1
 f.ClipsDescendants = true
 f.ZIndex = t.ZIndex + 40
 f.Parent = t
 for i = 1,c do
  local x = Instance.new("Frame")
  x.Name = "b"..i
  x.Size = UDim2.new(1,0,s,0)
  local y = (i-1) / math.max(1,c-1)
  x.Position = UDim2.new(0,0,y - s/2,0)
  x.BackgroundColor3 = Color3.fromRGB(255,255,255)
  x.BackgroundTransparency = 0.92
  x.ZIndex = f.ZIndex + 1
  local g = Instance.new("UIGradient")
  g.Rotation = 0
  g.Color = ColorSequence.new(
   ColorSequenceKeypoint.new(0,Color3.fromRGB(255,255,255)),
   ColorSequenceKeypoint.new(1,Color3.fromRGB(210,220,235))
  )
  g.Transparency = NumberSequence.new(
   NumberSequenceKeypoint.new(0,0.86),
   NumberSequenceKeypoint.new(1,0.95)
  )
  g.Parent = x
  x.Parent = f
  table.insert(u,x)
 end
 return {holder=f,bands=u}
end

