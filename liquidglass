function m:glass(t,u)
 local o = q(d,u or {})
 if a[t] then return a[t] end
 local p = Instance.new("Frame")
 p.Name = "lg_holder_"..h:GenerateGUID(false)
 p.Size = UDim2.fromScale(1,1)
 p.Position = UDim2.fromScale(0,0)
 p.BackgroundTransparency = 1
 p.ClipsDescendants = true
 p.ZIndex = t.ZIndex + 1
 p.Parent = t
 local c = Instance.new("UICorner")
 c.CornerRadius = UDim.new(0,o.corner or d.corner)
 c.Parent = p
 local st = Instance.new("UIStroke")
 st.Thickness = 1.4
 st.Color = Color3.fromRGB(255,255,255)
 st.Transparency = 0.35
 st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
 st.Parent = p
 local bg = Instance.new("UIGradient")
 bg.Rotation = 135
 bg.Color = ColorSequence.new(
  ColorSequenceKeypoint.new(0,Color3.fromRGB(190,210,240)),
  ColorSequenceKeypoint.new(0.3,Color3.fromRGB(120,145,190)),
  ColorSequenceKeypoint.new(1,Color3.fromRGB(10,12,20))
 )
 bg.Transparency = NumberSequence.new(
  NumberSequenceKeypoint.new(0,0.15),
  NumberSequenceKeypoint.new(1,0.4)
 )
 bg.Parent = p
 local v = s(p,o)
 local bd = b(p,o)
 local L = {}
 local cnt = o.layers or d.layers
 for i = 1,cnt do
  local vf = Instance.new("ViewportFrame")
  vf.Name = "lg_view_"..i
  vf.Size = UDim2.fromScale(1,1)
  vf.Position = UDim2.fromScale(0,0)
  vf.BackgroundTransparency = 1
  vf.BorderSizePixel = 0
  vf.LightColor = Color3.fromRGB(255,255,255)
  vf.Ambient = Color3.fromRGB(10,10,18)
  vf.ImageColor3 = Color3.new(1,1,1)
  vf.ZIndex = p.ZIndex + i * 2
  vf.Parent = p
  local wm = Instance.new("WorldModel")
  wm.Name = "lg_wm_"..i
  wm.Parent = vf
  local c2 = Instance.new("Camera")
  c2.Name = "lg_cam_"..i
  c2.Parent = wm
  vf.CurrentCamera = c2
  local tint = Instance.new("Frame")
  tint.Name = "lg_tint_"..i
  tint.Size = UDim2.fromScale(1,1)
  tint.Position = UDim2.new(0,0,0,0)
  tint.BackgroundTransparency = 1
  tint.ZIndex = vf.ZIndex + 1
  tint.Parent = p
  table.insert(L,{vp=vf,wm=wm,cam=c2,tint=tint,idx=i})
 end
 for _,x in ipairs(L) do
  task.spawn(function()
   k(x.wm,o)
  end)
 end
 local cc = 0
 local hb
 hb = r.Heartbeat:Connect(function(dt)
  cc = cc + dt
  if cc >= (o.refreq or d.refreq) then
   for _,x in ipairs(L) do
    k(x.wm,o)
   end
   cc = 0
  end
 end)
 local tt = 0
 local rs
 rs = r.RenderStepped:Connect(function(dt)
  if not p or not p.Parent then
   rs:Disconnect()
   if hb then hb:Disconnect() end
   a[t] = nil
   return
  end
  tt = tt + dt * (o.speed or d.speed)
  if v and v.top and v.bot then
   local n1 = math.noise(tt*0.24,3)
   local n2 = math.noise(tt*0.2,6)
   v.top.Rotation = (n1-0.5)*5
   v.bot.Rotation = (n2-0.5)*4 + 180
  end
  if bd and bd.bands then
   for i,x in ipairs(bd.bands) do
    local n = math.noise(tt*0.7 + i*0.13,i*0.41)
    local j = (n-0.5)*0.03*(o.wobble or d.wobble)
    local nx = (math.noise(tt*0.4,i*0.29)-0.5)*0.018
    local ys = x.Position.Y.Scale + j
    if ys > 1.15 then ys = -0.12 end
    if ys < -0.2 then ys = 1.05 end
    x.Position = UDim2.new(nx,0,ys,0)
   end
  end
  local cam = w.CurrentCamera
  if cam then
   for i,x in ipairs(L) do
    local c2 = x.cam
    local nx = (math.noise(tt*(0.9+i*0.05),i*7)-0.5)*(o.wobble or d.wobble)*(0.6+i*0.4)
    local ny = (math.noise(tt*(1.1+i*0.06),i*11)-0.5)*(o.wobble or d.wobble)*(0.5+i*0.4)
    local off = CFrame.new(nx,ny,0)
    local rot = CFrame.Angles(0,0,(math.noise(tt*0.65,i*3)-0.5)*0.02)
    c2.CFrame = cam.CFrame * off * rot
    c2.FieldOfView = cam.FieldOfView + (i-1)*(o.spread or d.spread)
   end
   if o.chroma then
    local cols = {
     Color3.fromRGB(255,200,210),
     Color3.fromRGB(200,225,255),
     Color3.fromRGB(210,255,220)
    }
    for i,x in ipairs(L) do
     local t2 = x.tint
     if i <= 3 then
      local nx = (math.noise(tt*0.5,i*2)-0.5)*0.006*i
      local ny = (math.noise(tt*0.42,i*3)-0.5)*0.006*i
      t2.BackgroundColor3 = cols[i]
      t2.BackgroundTransparency = 0.9
      t2.Position = UDim2.new(nx,0,ny,0)
     else
      t2.BackgroundTransparency = 1
     end
    end
   else
    for _,x in ipairs(L) do
     x.tint.BackgroundTransparency = 1
    end
   end
  end
 end)
 local h2 = {}
 h2._holder = p
 h2._layers = L
 h2._bands = bd
 h2._sheen = v
 h2._hb = hb
 h2._rs = rs
 h2._opts = o
 function h2:destroy()
  if self._rs then self._rs:Disconnect() end
  if self._hb then self._hb:Disconnect() end
  if self._holder and self._holder.Parent then self._holder:Destroy() end
 end
 a[t] = h2
 return h2
end

function m:isglass(t)
 return a[t] ~= nil
end

return setmetatable({},m)