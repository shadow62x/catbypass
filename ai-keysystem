local a = {}
a.cfg = {
    title = "yourscript",
    desc = "your script description here",
    note = "join discord.gg/yourserver to get your key",
    bgcolor = Color3.fromRGB(15,15,25),
    accent = Color3.fromRGB(88,177,255),
    text = Color3.fromRGB(255,255,255),
    text2 = Color3.fromRGB(180,180,200),
    border = Color3.fromRGB(50,50,70),
    hover = Color3.fromRGB(100,190,255),
    corn = UDim.new(0,12),
    speed = 0.25,
    keys = {"KEY123","TESTKEY456","DEMO789"},
    getkey_link = "https://your.link/here",
    notif_life = 3
}

local tween = game:GetService("TweenService")
local core = game:GetService("CoreGui")

local nroot
local noff = 0

local function ninit()
    if nroot and nroot.Parent then return nroot end
    local g = Instance.new("ScreenGui")
    g.Name = "ks_notif_gui"
    g.IgnoreGuiInset = true
    g.ResetOnSpawn = false
    g.Parent = core
    local f = Instance.new("Frame")
    f.Name = "root"
    f.AnchorPoint = Vector2.new(1,0)
    f.Position = UDim2.new(1,-20,0,20)
    f.Size = UDim2.new(0,260,1,-40)
    f.BackgroundTransparency = 1
    f.Parent = g
    nroot = f
    noff = 0
    return f
end

local function notify(txt, col)
    local r = ninit()
    noff = noff + 1
    local b = Instance.new("Frame")
    b.Name = "n"
    b.AnchorPoint = Vector2.new(1,0)
    b.Size = UDim2.new(0,260,0,38)
    b.Position = UDim2.new(1,0,0,(noff-1)*42)
    b.BackgroundColor3 = a.cfg.bgcolor
    b.BackgroundTransparency = 0.1
    b.BorderSizePixel = 0
    b.Parent = r
    local c1 = Instance.new("UICorner")
    c1.CornerRadius = UDim.new(0,8)
    c1.Parent = b
    local s = Instance.new("UIStroke")
    s.Color = col or a.cfg.accent
    s.Thickness = 1.5
    s.Parent = b
    local t = Instance.new("TextLabel")
    t.BackgroundTransparency = 1
    t.Size = UDim2.new(1,-12,1,-8)
    t.Position = UDim2.new(0,8,0,4)
    t.Font = Enum.Font.Gotham
    t.TextSize = 13
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.TextYAlignment = Enum.TextYAlignment.Center
    t.TextColor3 = a.cfg.text
    t.Text = txt or "notification"
    t.Parent = b
    b.BackgroundTransparency = 1
    t.TextTransparency = 1
    s.Transparency = 1
    tween:Create(b,TweenInfo.new(0.25,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{BackgroundTransparency = 0.1}):Play()
    tween:Create(t,TweenInfo.new(0.25),{TextTransparency = 0}):Play()
    tween:Create(s,TweenInfo.new(0.25),{Transparency = 0}):Play()
    task.delay(a.cfg.notif_life,function()
        tween:Create(b,TweenInfo.new(0.25),{BackgroundTransparency = 1}):Play()
        tween:Create(t,TweenInfo.new(0.25),{TextTransparency = 1}):Play()
        tween:Create(s,TweenInfo.new(0.25),{Transparency = 1}):Play()
        task.wait(0.27)
        if b and b.Parent then
            b:Destroy()
        end
        noff = math.max(noff-1,0)
        local idx = 0
        for _,k in ipairs(r:GetChildren()) do
            if k:IsA("Frame") then
                idx = idx + 1
                tween:Create(k,TweenInfo.new(0.18),{Position = UDim2.new(1,0,0,(idx-1)*42)}):Play()
            end
        end
    end)
end

