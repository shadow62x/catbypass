function a:settheme(m)
    if m == "dark" then
        self.cfg.bgcolor = Color3.fromRGB(15,15,25)
        self.cfg.text = Color3.fromRGB(255,255,255)
        self.cfg.text2 = Color3.fromRGB(180,180,200)
        self.cfg.border = Color3.fromRGB(50,50,70)
        self.cfg.accent = Color3.fromRGB(88,177,255)
        self.cfg.hover = Color3.fromRGB(100,190,255)
    elseif m == "light" then
        self.cfg.bgcolor = Color3.fromRGB(245,245,250)
        self.cfg.text = Color3.fromRGB(20,20,40)
        self.cfg.text2 = Color3.fromRGB(100,100,130)
        self.cfg.border = Color3.fromRGB(200,200,220)
        self.cfg.accent = Color3.fromRGB(70,150,255)
        self.cfg.hover = Color3.fromRGB(90,170,255)
    end
end

function a:config(tbl)
    for k,v in pairs(tbl) do
        self.cfg[k] = v
    end
end

function a:show(cb)
    local ui = make_ui(cb)
    return ui
end

return a