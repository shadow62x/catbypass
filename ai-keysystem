        pulse(gk)
        setclipboard(a.cfg.getkey_link or "https://your.link/here")
        notify("key link copied to clipboard",a.cfg.accent)
    end)

    vk.MouseButton1Click:Connect(function()
        pulse(vk)
        local v = tb.Text:upper()
        local ok = false
        for _,k in ipairs(a.cfg.keys) do
            if v == k then
                ok = true
                break
            end
        end
        if ok then
            tween:Create(vk,TweenInfo.new(0.3),{BackgroundColor3 = Color3.fromRGB(76,175,80)}):Play()
            vk.Text = "✓ valid key"
            notify("key verified, loading...",Color3.fromRGB(76,175,80))
            task.wait(1)
            g:Destroy()
            if typeof(cb) == "function" then cb() end
        else
            notify("invalid key",Color3.fromRGB(200,80,80))
            tween:Create(h,TweenInfo.new(0.08),{Position = h.Position + UDim2.new(0,10,0,0)}):Play()
